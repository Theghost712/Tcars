# Copy to backend/.env for local development. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/tanzania_car_marketplace
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Development prints emails to the console. Production uses SMTP:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Tanzania Car Marketplace <no-reply@localhost>
