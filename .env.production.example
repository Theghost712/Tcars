# Copy to .env in the repository root for docker compose. Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DJANGO_SECRET_KEY=change-me-to-a-50-plus-character-random-string
DJANGO_ALLOWED_HOSTS=marketplace.example.tz,localhost
DJANGO_SECURE_SSL_REDIRECT=false
CSRF_TRUSTED_ORIGINS=https://marketplace.example.tz
CORS_ALLOWED_ORIGINS=https://marketplace.example.tz
FRONTEND_URL=https://marketplace.example.tz
DEFAULT_FROM_EMAIL=Tanzania Car Marketplace <no-reply@marketplace.example.tz>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.tz
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
